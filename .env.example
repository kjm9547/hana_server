# cp .env.example .env 후 JWT_SECRET을 바꾼다: openssl rand -hex 32
JWT_SECRET=change-me-to-at-least-32-random-bytes
DATABASE_URL=postgres://hana:hana@localhost:5433/hana_dev

# 사진 저장소: local(기본, 서버의 UPLOAD_DIR 폴더) · s3(연결 예정)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# s3로 바꿀 때 채운다 (src/storage/image-storage.ts의 메모 참고)
# S3_BUCKET=
# S3_REGION=ap-northeast-2
# S3_PUBLIC_BASE_URL=https://<bucket>.s3.ap-northeast-2.amazonaws.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
